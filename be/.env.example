# Salin jadi .env lalu isi.

# Supabase > Connect > Session pooler (jangan tambahkan ?sslmode=...; SSL diatur otomatis)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST_POOLER:5432/postgres

# Minimal 32 karakter. Buat: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3000
# Asal web yang boleh memanggil API, pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173
# Alamat web sekolah (tampilan anak)
WEB_URL=http://localhost:5173
# Awal link undangan orang tua (dikirim lewat WhatsApp). Isi dengan deep link aplikasi orang tua,
# mis. satu://undangan atau https://satu.app/undangan. Kosong = WEB_URL/undangan. Token ditempel di akhir.
INVITE_URL=
# Alamat publik backend tanpa /api, untuk URL video tutorial (mis. https://tunarungu.neotelemetri.id).
# Kosong = URL relatif /tutorial/...; aplikasi mobile butuh URL lengkap, jadi isi di server.
PUBLIC_URL=

# Layanan AI teman ML, termasuk awalan /ai. Di VPS: http://127.0.0.1:7777/ai (jangan dibuka ke internet).
# Kosongkan = hanya aturan cadangan.
AI_URL=
AI_TIMEOUT_MS=5000
AI_LLM_TIMEOUT_MS=20000

# Koneksi database per proses. Cluster N proses memakai N x ini; jaga di bawah batas Session pooler Supabase (default 15).
DB_POOL_MAX=3

# Jumlah latihan lulus per hari agar streak bertambah
STREAK_MIN_PRACTICES=3
